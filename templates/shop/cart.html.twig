{% extends 'base.html.twig' %}

{% block title %}Mon Panier - ShopEasy
{% endblock %}

{% block body %}
	<div class="cart-container">
		<h1>Votre Panier</h1>

		{% if cart_items|length > 0 %}
			<div class="cart-content">
				<div class="cart-items">
					{% for item in cart_items %}
						<div class="glass-card cart-item">
							<div class="item-info">
								<h3>{{ item.name }}</h3>
								<p class="unit-price">{{ item.price|number_format(2, ',', ' ') }}
									€ / unité</p>
							</div>

							<div class="item-actions">
								<form action="{{ base_url }}/shop/update" method="POST" class="update-form">
									<input type="hidden" name="product_id" value="{{ item.id }}">
									<div class="quantity-selector">
										<button type="submit" name="quantity" value="{{ item.quantity - 1 }}" class="qty-btn">-</button>
										<input type="number" value="{{ item.quantity }}" readonly>
										<button type="submit" name="quantity" value="{{ item.quantity + 1 }}" class="qty-btn">+</button>
									</div>
								</form>

								<p class="item-total">{{ (item.price * item.quantity)|number_format(2, ',', ' ') }}
									€</p>

								<form action="{{ base_url }}/shop/remove" method="POST">
									<input type="hidden" name="product_id" value="{{ item.id }}">
									<button type="submit" class="remove-btn">&times;</button>
								</form>
							</div>
						</div>
					{% endfor %}
				</div>

				<div class="cart-summary glass-card">
					<h2>Récapitulatif</h2>
					<div class="summary-line">
						<span>Total</span>
						<span class="total-amount">{{ cart_total|number_format(2, ',', ' ') }}
							€</span>
					</div>
					<div class="summary-line points-line">
						<span>Points à gagner</span>
						<span class="points-gain">+{{ loyalty_points }}
							pts</span>
					</div>
					<a href="{{ base_url }}/shop/checkout" class="btn btn-primary checkout-btn">Passer au paiement</a>
					<a href="{{ base_url }}/shop" class="continue-link">Continuer les achats</a>
				</div>
			</div>
		{% else %}
			<div class="empty-cart glass-card">
				<p>Votre panier est vide.</p>
				<a href="{{ base_url }}/shop" class="btn btn-primary">Aller à la boutique</a>
			</div>
		{% endif %}
	</div>

	<style>
		.cart-container h1 {
			margin-bottom: 2rem;
			font-size: 2.5rem;
		}

		.cart-content {
			display: grid;
			grid-template-columns: 1fr 350px;
			gap: 2rem;
			align-items: start;
		}

		.cart-items {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.cart-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 1.5rem;
		}

		.item-info h3 {
			margin-bottom: 0.2rem;
		}

		.unit-price {
			color: var(--text-muted);
			font-size: 0.9rem;
		}

		.item-actions {
			display: flex;
			align-items: center;
			gap: 2rem;
		}

		.item-total {
			font-weight: 700;
			font-size: 1.1rem;
			min-width: 100px;
			text-align: right;
		}

		.quantity-selector {
			display: flex;
			align-items: center;
			background: rgba(255, 255, 255, 0.05);
			border-radius: 6px;
			border: 1px solid var(--glass-border);
		}

		.qty-btn {
			background: none;
			border: none;
			color: white;
			padding: 0.3rem 0.8rem;
			cursor: pointer;
		}

		.quantity-selector input {
			width: 30px;
			text-align: center;
			background: none;
			border: none;
			color: white;
			font-weight: 600;
		}

		.remove-btn {
			background: rgba(239, 68, 68, 0.1);
			color: #ef4444;
			border: 1px solid rgba(239, 68, 68, 0.2);
			width: 30px;
			height: 30px;
			border-radius: 50%;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.2rem;
			transition: all 0.3s;
		}

		.remove-btn:hover {
			background: #ef4444;
			color: white;
		}

		.cart-summary {
			padding: 2rem;
			position: sticky;
			top: 100px;
		}

		.summary-line {
			display: flex;
			justify-content: space-between;
			margin: 1.5rem 0;
			font-size: 1.1rem;
		}

		.total-amount {
			font-size: 1.8rem;
			font-weight: 700;
			color: var(--primary);
		}

		.points-line {
			padding-top: 1rem;
			border-top: 1px solid var(--glass-border);
		}

		.points-gain {
			color: #fbbf24;
			font-weight: 700;
		}

		.checkout-btn {
			width: 100%;
			text-align: center;
			margin-top: 1rem;
		}

		.continue-link {
			display: block;
			text-align: center;
			margin-top: 1rem;
			color: var(--text-muted);
			text-decoration: none;
			font-size: 0.9rem;
		}

		.continue-link:hover {
			color: var(--text-main);
		}

		.empty-cart {
			text-align: center;
			padding: 4rem;
		}

		.empty-cart p {
			margin-bottom: 2rem;
			font-size: 1.2rem;
			color: var(--text-muted);
		}

		@media(max-width: 992px) {
			.cart-content {
				grid-template-columns: 1fr;
			}
		}
	</style>
{% endblock %}
