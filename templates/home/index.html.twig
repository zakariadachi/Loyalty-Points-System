{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="hero">
    <h1>{{ welcome_message }}</h1>
    <p class="subtitle">Gagnez des points sur chaque achat et transformez-les en récompenses exclusives.</p>
    
    <div class="features-grid">
        <div class="glass-card feature">
            <div class="icon">✨</div>
            <h3>Gagnez</h3>
            <p>累積 points pour chaque euro dépensé chez nos partenaires.</p>
        </div>
        <div class="glass-card feature">
            <div class="icon">🎁</div>
            <h3>Échangez</h3>
            <p>Profitez d'un large catalogue de récompenses et de remises.</p>
        </div>
        <div class="glass-card feature">
            <div class="icon">🚀</div>
            <h3>Accélérez</h3>
            <p>Participez à des événements spéciaux pour booster vos points.</p>
        </div>
    </div>

    {% if session.user_id is not defined %}
    <div class="cta-section">
        <a href="{{ base_url }}/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Commencer maintenant</a>
    </div>
    {% endif %}
</div>

<style>
    .hero {
        text-align: center;
        padding: 4rem 0;
    }

    h1 {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        background: linear-gradient(to bottom right, #fff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--text-muted);
        max-width: 600px;
        margin: 0 auto 4rem;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-bottom: 4rem;
    }

    .feature {
        transition: transform 0.3s;
    }

    .feature:hover {
        transform: translateY(-10px);
        border-color: var(--primary);
    }

    .feature .icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .feature h3 {
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }

    .feature p {
        color: var(--text-muted);
        line-height: 1.6;
    }

    .cta-section {
        margin-top: 2rem;
    }

    @media (max-width: 768px) {
        h1 { font-size: 2.5rem; }
    }
</style>
{% endblock %}
